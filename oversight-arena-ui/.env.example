# Base URL of the Oversight Arena backend API, used by lib/api.ts.
#
# Leave unset for the combined deployment (Docker / HF Space): the FastAPI app
# serves this exported UI and the API on the same origin, so the default "/api" works.
#
# For `npm run dev` (UI on :3000, no proxy), run the backend locally and point at it:
#   uvicorn oversight_arena.server.app:app --port 7860
#   NEXT_PUBLIC_API_BASE=http://127.0.0.1:7860/api
#
# NEXT_PUBLIC_* values are inlined at build time. Never point this at a shared remote
# environment you do not want reset: the UI calls POST /reset on load.
NEXT_PUBLIC_API_BASE=
